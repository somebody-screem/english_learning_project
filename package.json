{
  "name": "phrase-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "desktop": "npm run build && electron .",
    "package": "npm run build && electron-builder --win portable",
    "format": "prettier --write src tests e2e electron *.ts *.json"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.3.0",
    "electron-builder": "^26.0.12",
    "prettier": "^3.9.6",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vitest": "^4.1.11"
  },
  "build": {
    "appId": "jp.phrase.learning",
    "productName": "Phrase",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "Phrase-${version}-Windows.exe"
    },
    "compression": "store"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "description": "Offline English sentence ordering practice",
  "author": "Phrase",
  "engines": {
    "node": ">=22.12.0"
  }
}
